# ==============================================================
# FOGAMI Search - Environment Variables
# ==============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your domain name (leave as localhost for local testing)
SEARXNG_HOSTNAME=localhost

# Email for SSL certificate via Let's Encrypt (leave empty for localhost)
SEARXNG_TLS=

# Secret key - generate a random one with:
#   openssl rand -hex 32
SEARXNG_SECRET=REPLACE_WITH_YOUR_OWN_SECRET_KEY
