# ==============================================================
# FOGAMI Search - .gitignore
# ==============================================================

# Environment variables (contain secrets - NEVER commit these)
.env

# SearXNG secret key in settings - replace with placeholder before pushing
# (handled separately via .env.example)

# Docker volumes and runtime data
caddy-data/
caddy-config/
data/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor folders
.vscode/
.idea/
*.suo
*.user

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
